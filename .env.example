# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env)
# Trading Bot Cuantitativo + Machine Learning + GCP VM + Telegram + Gemini
# ==============================================================================

# 1. MODO DE OPERACIÓN
# PAPER_TRADING=true (recomendado para simulación segura y defensa en vivo)
# PAPER_TRADING=false (para órdenes reales en Testnet de Bybit o Binance)
PAPER_TRADING=true
# AUTO_TRADING_ENABLED=true (el bot escanea 24/7 y abre trades automáticamente al detectar confluencia)
AUTO_TRADING_ENABLED=true
INITIAL_BALANCE=10000.0
DEFAULT_TICKER=BTCUSDT

# 2. GOOGLE GEMINI API (Obtener en https://aistudio.google.com/ o Vertex AI)
# Esencial para el análisis cualitativo y explicativo del agente
GEMINI_API_KEY=AIzaSyTuClaveDeGoogleGeminiAqui

# 3. TELEGRAM CHATOPS BOT (Obtener con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz
# Tu chat_id personal o de grupo (obtener enviando /start al bot @userinfobot)
TELEGRAM_CHAT_ID=987654321

# 4. EXCHANGES TESTNET CREDENTIALS (Opcional si usas PAPER_TRADING=true)
# Testnet Bybit: https://testnet.bybit.com
BYBIT_API_KEY=tu_api_key_bybit_testnet
BYBIT_API_SECRET=tu_api_secret_bybit_testnet

# Testnet Binance: https://testnet.binance.vision
BINANCE_API_KEY=tu_api_key_binance_testnet
BINANCE_API_SECRET=tu_api_secret_binance_testnet

# 5. CONFIGURACIÓN DEL SERVIDOR WEB DASHBOARD
WEB_HOST=0.0.0.0
WEB_PORT=8080
ADMIN_USERNAME=trader_admin
ADMIN_PASSWORD=cuantitativo2026

# 6. CONFIGURACIÓN DE RIESGO
RISK_PER_TRADE_PERCENT=0.02
ATR_STOP_LOSS_MULTIPLIER=1.5
ATR_TAKE_PROFIT_MULTIPLIER=2.5
MAX_DRAWDOWN_LIMIT=0.15

