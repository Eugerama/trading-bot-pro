[Unit]
Description=Quantitative AI Trading Bot and Web Dashboard (GCP Compute Engine)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/trading-bot-pro
ExecStart=/opt/trading-bot-pro/venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=append:/opt/trading-bot-pro/trading_bot.log
StandardError=append:/opt/trading-bot-pro/trading_bot.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

